  },
  "entries": [
    {
      "id": "customer-orders",
      "kind": "template",
      "name": "Orders placed by a customer",
      "description": "Find orders and the customer display name. 按客户查询订单。",
      "template": {
        "enabled": true,
        "tool": "query_sql",
        "query_json": "{\"query\": \"SELECT o.order_key, o.total_decimal, c.full_name FROM public.sales_orders o JOIN public.crm_customers c ON c.customer_key = o.customer_key WHERE c.customer_key = $1 ORDER BY o.order_key\", \"params\": [\"C-100\"]}",
        "parameters": [
          {
            "name": "customer_id",
            "type": "string",
            "required": true,
            "pointers": [
              "/params/0"
            ]
          }
        ],
        "example_json": "{\"customer_id\":\"C-100\"}",
        "result_description": "Native rows or documents; exact decimal amounts are preserved.",
        "concept_refs": [
          "ontology:entity_type:Customer",
          "ontology:entity_type:Order",
          "ontology:relation_type:places",
          "ontology:property:Order:total"
        ]
      }
    }
  ]
